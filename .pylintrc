[MASTER]
fail-under=8.0

# Single-file architecture: keep everything in jira-briefer.py with lazy,
# optional imports (python-dotenv, prompt_toolkit, jdatetime). Disable rules
# that conflict with that intentional design and with the ANSI-color renderer.

[MESSAGES CONTROL]
disable=
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-statements,
    too-many-branches,
    too-many-return-statements,
    invalid-name,
    redefined-outer-name,
    import-outside-toplevel,
    wrong-import-order,
    broad-exception-caught,
    consider-using-with,
    missing-function-docstring,
    line-too-long,
    f-string-without-interpolation

[FORMAT]
max-line-length=120

[STRING]
check-quote-consistency=no
