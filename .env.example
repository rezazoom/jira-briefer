# Jira credentials example — copy to `.env` and fill in real values.
# Do NOT commit the real `.env` file.

# Your Jira username
JIRA_USERNAME=your-username

# Personal Access Token (PAT) from Jira:
#   Profile (avatar) → Personal Access Tokens → Create token
# Preferred auth method (Bearer token).
JIRA_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN_HERE

# Alternate auth methods — only used if JIRA_TOKEN is NOT set.
# Basic auth with your Jira password:
# JIRA_PASSWORD=your_jira_password
# Basic auth with a Jira API token (username + API token):
# JIRA_API_TOKEN=your_api_token

# Jira server base URL (required)
# JIRA_BASE_URL=https://jira.example.com

# Report output format in the menu: console | html
# JIRA_OUTPUT_FORMAT=console
